[resource]
script = ExtResource("1_zona")
id = "acuatica"
nombre = "Zona Acuática"
descripcion = "El espejo de agua del humedal. Aquí nadan las aves acuáticas y pescan las garzas."
color = Color(0.2, 0.5, 0.95, 1)
posicion = Vector2(3.6, 1.6)
radio = 2.5
especies = Array[ExtResource("2_esp")]([ExtResource("3_tingua_pico_rojo"), ExtResource("4_garza_blanca")])
