[sub_resource type="Resource" id="m1"]
script = ExtResource("3_mis")
id = "agua_abierta_1"
tipo = 3
especial = true
enunciado = "Misión especial: ¿cómo podemos evitar que el agua del humedal se contamine? Propón tres acciones que puedan hacer tu familia y tu barrio."
opciones = PackedStringArray()
correcta = 0
especie_id = ""
explicacion = "¡Gracias! Tu propuesta quedó guardada en tu Bioentdex. No botar aceite ni basura al desagüe y cuidar la ronda son buenas acciones para empezar."
conceptos_obligatorios = PackedStringArray("aceite", "basura", "ronda")

[sub_resource type="Resource" id="m2"]
script = ExtResource("3_mis")
id = "agua_abierta_2"
tipo = 0
especial = false
enunciado = "¿Por qué el agua de un humedal se ve oscura y verdosa?"
opciones = PackedStringArray("Porque siempre está sucia", "Por la materia orgánica y las algas que viven en ella", "Porque refleja los edificios")
correcta = 1
especie_id = ""
explicacion = "El color viene de la materia orgánica y de microalgas. Es normal, aunque un exceso de algas indica contaminación."

[sub_resource type="Resource" id="m3"]
script = ExtResource("3_mis")
id = "agua_abierta_3"
tipo = 1
especial = false
enunciado = "¿Qué ave es esta?"
opciones = PackedStringArray("Tingua de pico rojo", "Garza blanca", "Pato canadiense")
correcta = 0
especie_id = "tingua_pico_rojo"
explicacion = "Se reconoce por el escudo rojo de la frente y el pico de punta amarilla."

[sub_resource type="Resource" id="m4"]
script = ExtResource("3_mis")
id = "agua_abierta_4"
tipo = 2
especial = false
enunciado = "Toma una foto del espejo de agua. ¿Ves la lenteja de agua flotando?"
opciones = PackedStringArray()
correcta = 0
especie_id = "lenteja_de_agua"
explicacion = "La lenteja de agua forma un tapete verde que alimenta a patos y tinguas."
recompensa_digital = 1

[resource]
script = ExtResource("1_zona")
id = "agua_abierta"
nombre = "Zona de Agua Abierta"
descripcion = "El espejo de agua del humedal, sin plantas encima. Aquí nadan y se alimentan las aves acuáticas."
color = Color(0.2, 0.5, 0.95, 1)
posicion = Vector2(3.1, 6.7)
radio = 5.0
especies = Array[ExtResource("2_esp")]([ExtResource("4_tingua_pico_rojo"), ExtResource("5_garza_blanca"), ExtResource("6_lenteja_de_agua"), ExtResource("7_libelula"), ExtResource("8_zancudo"), ExtResource("9_tipula"), ExtResource("10_playero_solitaria"), ExtResource("11_coquito")])
misiones = Array[ExtResource("3_mis")]([SubResource("m1"), SubResource("m2"), SubResource("m3"), SubResource("m4")])
