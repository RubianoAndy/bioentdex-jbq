[gd_resource type="Resource" script_class="Zona" format=3]

[ext_resource type="Script" path="res://zonas/zona.gd" id="1_zona"]
[ext_resource type="Script" path="res://especies/especie.gd" id="2_esp"]
[ext_resource type="Script" path="res://zonas/mision.gd" id="3_mis"]
[ext_resource type="Resource" path="res://especies/datos/tingua_bogotana.tres" id="4_tingua_bogotana"]
[ext_resource type="Resource" path="res://especies/datos/rana_sabanera.tres" id="5_rana_sabanera"]
[ext_resource type="Resource" path="res://especies/datos/enea.tres" id="6_enea"]
[ext_resource type="Resource" path="res://especies/datos/caballito_del_diablo.tres" id="7_caballito_del_diablo"]
[ext_resource type="Resource" path="res://especies/datos/libelula.tres" id="8_libelula"]

[sub_resource type="Resource" id="m1"]
script = ExtResource("3_mis")
id = "transicion_1"
tipo = 0
enunciado = "¿Qué hacen los juncos y las eneas por el humedal?"
opciones = PackedStringArray("Filtran el agua y dan refugio a la fauna", "Secan el humedal", "Solo sirven de adorno")
correcta = 0
especie_id = ""
explicacion = "Sus raíces atrapan sedimentos y contaminantes, y entre sus tallos se esconden y anidan las aves."

[sub_resource type="Resource" id="m2"]
script = ExtResource("3_mis")
id = "transicion_2"
tipo = 1
enunciado = "Esta ave está en peligro de extinción. ¿Cuál es?"
opciones = PackedStringArray("Copetón", "Tingua bogotana", "Mirla patiamarilla")
correcta = 1
especie_id = "tingua_bogotana"
explicacion = "La tingua bogotana solo vive en los humedales del altiplano cundiboyacense."

[sub_resource type="Resource" id="m3"]
script = ExtResource("3_mis")
id = "transicion_3"
tipo = 1
enunciado = "¿Qué animal es este?"
opciones = PackedStringArray("Rana sabanera", "Lombriz roja", "Chucha")
correcta = 0
especie_id = "rana_sabanera"
explicacion = "La rana sabanera es endémica de la cordillera Oriental de Colombia."

[sub_resource type="Resource" id="m4"]
script = ExtResource("3_mis")
id = "transicion_4"
tipo = 2
enunciado = "Toma una foto de las eneas de la orilla."
opciones = PackedStringArray()
correcta = 0
especie_id = "enea"
explicacion = "Las eneas se reconocen por sus espigas cafés en forma de salchicha."

[resource]
script = ExtResource("1_zona")
id = "transicion"
nombre = "Zona de Transición"
descripcion = "La franja entre el agua y la tierra firme. Juncos y eneas crecen en el barro y dan refugio a ranas y aves."
color = Color(0.55, 0.85, 0.25, 1)
posicion = Vector2(-18.1, 16.9)
radio = 4.0
especies = Array[ExtResource("2_esp")]([ExtResource("4_tingua_bogotana"), ExtResource("5_rana_sabanera"), ExtResource("6_enea"), ExtResource("7_caballito_del_diablo"), ExtResource("8_libelula")])
misiones = Array[ExtResource("3_mis")]([SubResource("m1"), SubResource("m2"), SubResource("m3"), SubResource("m4")])
