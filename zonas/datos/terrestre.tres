[gd_resource type="Resource" script_class="Zona" format=3]

[ext_resource type="Script" path="res://zonas/zona.gd" id="1_zona"]
[ext_resource type="Script" path="res://especies/especie.gd" id="2_esp"]
[ext_resource type="Script" path="res://zonas/mision.gd" id="3_mis"]
[ext_resource type="Resource" path="res://especies/datos/copeton.tres" id="4_copeton"]
[ext_resource type="Resource" path="res://especies/datos/abejorro.tres" id="5_abejorro"]
[ext_resource type="Resource" path="res://especies/datos/mariposa_blanca.tres" id="6_mariposa_blanca"]
[ext_resource type="Resource" path="res://especies/datos/mariquita.tres" id="7_mariquita"]

[sub_resource type="Resource" id="m1"]
script = ExtResource("3_mis")
id = "terrestre_1"
tipo = 1
enunciado = "¿Qué ave es esta?"
opciones = PackedStringArray("Copetón", "Monjita bogotana", "Tingua bogotana")
correcta = 0
especie_id = "copeton"
explicacion = "El copetón tiene un pequeño copete y un collar rojizo en la nuca."

[sub_resource type="Resource" id="m2"]
script = ExtResource("3_mis")
id = "terrestre_2"
tipo = 0
enunciado = "¿Por qué son importantes los abejorros?"
opciones = PackedStringArray("Porque polinizan las flores", "Porque se comen las plantas", "Porque limpian el agua")
correcta = 0
especie_id = ""
explicacion = "Al visitar las flores llevan el polen de una a otra, y así las plantas producen semillas y frutos."

[sub_resource type="Resource" id="m3"]
script = ExtResource("3_mis")
id = "terrestre_3"
tipo = 2
enunciado = "Toma una foto de una flor silvestre de la pradera."
opciones = PackedStringArray()
correcta = 0
especie_id = ""
explicacion = "Las flores silvestres alimentan a abejorros, mariposas y colibríes."

[resource]
script = ExtResource("1_zona")
id = "terrestre"
nombre = "Zona Terrestre"
descripcion = "Tierra firme y seca, con pastos y flores donde buscan alimento las aves y los insectos."
color = Color(0.95, 0.6, 0.3, 1)
posicion = Vector2(21.1, 1.6)
radio = 4.0
especies = Array[ExtResource("2_esp")]([ExtResource("4_copeton"), ExtResource("5_abejorro"), ExtResource("6_mariposa_blanca"), ExtResource("7_mariquita")])
misiones = Array[ExtResource("3_mis")]([SubResource("m1"), SubResource("m2"), SubResource("m3")])
