[sub_resource type="Resource" id="m1"]
script = ExtResource("3_mis")
id = "terrestre_1"
tipo = 0
especial = false
enunciado = "La mosca de las flores tiene rayas como una abeja. ¿Por qué?"
opciones = PackedStringArray("Para imitar a abejas y avispas y que no se la coman", "Porque es una abeja", "Para calentarse al sol")
correcta = 0
especie_id = ""
explicacion = "Imitar a un insecto con aguijón la protege de sus depredadores, aunque ella no pica."

[sub_resource type="Resource" id="m2"]
script = ExtResource("3_mis")
id = "terrestre_2"
tipo = 0
especial = false
enunciado = "¿Por qué son importantes los abejorros?"
opciones = PackedStringArray("Porque polinizan las flores", "Porque se comen las plantas", "Porque limpian el agua")
correcta = 0
especie_id = ""
explicacion = "Al visitar las flores llevan el polen de una a otra, y así las plantas producen semillas y frutos."

[sub_resource type="Resource" id="m3"]
script = ExtResource("3_mis")
id = "terrestre_3"
tipo = 2
especial = false
enunciado = "Toma una foto de una flor silvestre de la pradera."
opciones = PackedStringArray()
correcta = 0
especie_id = ""
explicacion = "Las flores silvestres alimentan a abejorros, mariposas y moscas de las flores."
recompensa_digital = 1

[sub_resource type="Resource" id="m4"]
script = ExtResource("3_mis")
id = "terrestre_4"
tipo = 0
especial = false
enunciado = "¿Qué es una ooteca?"
opciones = PackedStringArray("Una cápsula que protege los huevos de algunos insectos", "Una fase adulta de las libélulas", "Una planta flotante del humedal")
correcta = 0
especie_id = ""
explicacion = "Algunos insectos forman ootecas para proteger sus huevos. Esta recompensa es un modelo digital: no busques ni retires huevos o nidos."
recompensa_digital = 2

[resource]
script = ExtResource("1_zona")
id = "terrestre"
nombre = "Zona Terrestre"
descripcion = "Tierra firme y seca, con pastos y flores donde buscan alimento aves e insectos."
color = Color(0.95, 0.6, 0.3, 1)
posicion = Vector2(26.4, 2.0)
radio = 5.0
especies = Array[ExtResource("2_esp")]([ExtResource("4_copeton"), ExtResource("5_abejorro"), ExtResource("6_mariposa_blanca"), ExtResource("7_mariquita"), ExtResource("8_hormiga"), ExtResource("9_taquinido"), ExtResource("10_sirfido"), ExtResource("11_crisopa"), ExtResource("12_capita_negra"), ExtResource("13_turpial_oriental"), ExtResource("14_espiguero_negriblanco")])
misiones = Array[ExtResource("3_mis")]([SubResource("m1"), SubResource("m2"), SubResource("m3"), SubResource("m4")])
