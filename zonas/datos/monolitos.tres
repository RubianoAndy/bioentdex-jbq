[gd_resource type="Resource" script_class="Zona" format=3]

[ext_resource type="Script" path="res://zonas/zona.gd" id="1_zona"]
[ext_resource type="Script" path="res://especies/especie.gd" id="2_esp"]
[ext_resource type="Script" path="res://zonas/mision.gd" id="3_mis"]
[ext_resource type="Resource" path="res://especies/datos/junco.tres" id="4_junco"]
[ext_resource type="Resource" path="res://especies/datos/copeton.tres" id="5_copeton"]
[ext_resource type="Resource" path="res://especies/datos/ninfalida.tres" id="6_ninfalida"]
[ext_resource type="Resource" path="res://especies/datos/hormiga.tres" id="7_hormiga"]

[sub_resource type="Resource" id="m1"]
script = ExtResource("3_mis")
id = "monolitos_1"
tipo = 0
especial = false
enunciado = "¿Qué pueblo indígena habitó los humedales de la sabana de Bogotá?"
opciones = PackedStringArray("Los muiscas", "Los mayas", "Los incas")
correcta = 0
especie_id = ""
explicacion = "Los muiscas vivían en la sabana y aprovechaban los humedales para cultivar, pescar y tejer."

[sub_resource type="Resource" id="m2"]
script = ExtResource("3_mis")
id = "monolitos_2"
tipo = 0
especial = false
enunciado = "¿Para qué usaban los muiscas el junco?"
opciones = PackedStringArray("Para tejer esteras y canastos", "Para construir carreteras", "Para hacer vidrio")
correcta = 0
especie_id = "junco"
explicacion = "Los tallos largos del junco se secan y se tejen."

[sub_resource type="Resource" id="m3"]
script = ExtResource("3_mis")
id = "monolitos_3"
tipo = 2
especial = false
enunciado = "Toma una foto de los monolitos."
opciones = PackedStringArray()
correcta = 0
especie_id = ""
explicacion = "Cuidar el patrimonio también es cuidar el humedal."

[resource]
script = ExtResource("1_zona")
id = "monolitos"
nombre = "Zona de Monolitos Históricos"
descripcion = "Piedras que recuerdan a los muiscas, quienes habitaron estos humedales mucho antes de que existiera la ciudad."
color = Color(0.7, 0.7, 0.7, 1)
posicion = Vector2(4.9, -22.7)
radio = 5.0
especies = Array[ExtResource("2_esp")]([ExtResource("4_junco"), ExtResource("5_copeton"), ExtResource("6_ninfalida"), ExtResource("7_hormiga")])
misiones = Array[ExtResource("3_mis")]([SubResource("m1"), SubResource("m2"), SubResource("m3")])
