[gd_resource type="Resource" script_class="Zona" format=3]

[ext_resource type="Script" path="res://zonas/zona.gd" id="1_zona"]
[ext_resource type="Script" path="res://especies/especie.gd" id="2_esp"]
[ext_resource type="Script" path="res://zonas/mision.gd" id="3_mis"]
[ext_resource type="Resource" path="res://especies/datos/chucha.tres" id="4_chucha"]
[ext_resource type="Resource" path="res://especies/datos/copeton.tres" id="5_copeton"]
[ext_resource type="Resource" path="res://especies/datos/mosca_metalica.tres" id="6_mosca_metalica"]
[ext_resource type="Resource" path="res://especies/datos/polilla_geometra.tres" id="7_polilla_geometra"]
[ext_resource type="Resource" path="res://especies/datos/pececillo_plata.tres" id="8_pececillo_plata"]

[sub_resource type="Resource" id="m1"]
script = ExtResource("3_mis")
id = "urbana_1"
tipo = 3
especial = true
enunciado = "Misión especial: propón una campaña para que tu barrio cuide el humedal (carteles, jornadas de limpieza, siembra de plantas nativas…)."
opciones = PackedStringArray()
correcta = 0
especie_id = ""
explicacion = "¡Gracias! Tu propuesta quedó guardada en tu Bioentdex. Las campañas funcionan mejor cuando invitan a los vecinos a participar."
conceptos_obligatorios = PackedStringArray("vecinos", "limpieza", "nativas")

[sub_resource type="Resource" id="m2"]
script = ExtResource("3_mis")
id = "urbana_2"
tipo = 0
especial = false
enunciado = "¿Qué puedes hacer desde tu casa para proteger el humedal?"
opciones = PackedStringArray("Botar el aceite por el lavaplatos", "Separar residuos y no botar basura en la calle", "Dejar sueltas a las mascotas en el humedal")
correcta = 1
especie_id = ""
explicacion = "La basura y el aceite de la calle llegan al humedal por las alcantarillas."

[sub_resource type="Resource" id="m3"]
script = ExtResource("3_mis")
id = "urbana_3"
tipo = 1
especial = false
enunciado = "Este animal nativo es inofensivo. ¿Cuál es?"
opciones = PackedStringArray("Rata parda", "Chucha", "Copetón")
correcta = 1
especie_id = "chucha"
explicacion = "La chucha es un marsupial nativo: no la confundas con una rata."

[resource]
script = ExtResource("1_zona")
id = "urbana"
nombre = "Zona Urbana"
descripcion = "Donde la ciudad se encuentra con el humedal. Aun aquí vive fauna que aprendió a convivir con las personas."
color = Color(0.4, 0.6, 0.8, 1)
posicion = Vector2(24.3, 36.1)
radio = 5.0
especies = Array[ExtResource("2_esp")]([ExtResource("4_chucha"), ExtResource("5_copeton"), ExtResource("6_mosca_metalica"), ExtResource("7_polilla_geometra"), ExtResource("8_pececillo_plata")])
misiones = Array[ExtResource("3_mis")]([SubResource("m1"), SubResource("m2"), SubResource("m3")])
