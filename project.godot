; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Bioentdex Jbq"
run/main_scene="uid://cvqo7i4r3yyux"
config/features=PackedStringArray("4.7", "Mobile")
config/icon="res://icon.svg"

[autoload]

RegistroEspecies="*res://especies/registro_especies.gd"
AnaliticaPedagogica="*res://ui/analitica_pedagogica.gd"
Expedicion="*res://zonas/expedicion.gd"
DialogosColibri="*res://dialogos_colibri.gd"
Perfil="*res://perfil.gd"
Recompensas="*res://recompensas.gd"
DesplazamientoTactil="*res://ui/desplazamiento_tactil.gd"
FeedbackTactil="*res://ui/feedback_tactil.gd"
AudioManager="*res://audio/audio_manager.gd"

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[gui]

theme/custom="res://ui/tema.tres"

[input_devices]

pointing/emulate_touch_from_mouse=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
renderer/rendering_method="mobile"
