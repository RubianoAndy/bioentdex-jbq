[ext_resource type="Script" path="res://especies/especie.gd" id="1_esp"]

[resource]
script = ExtResource("1_esp")
numero = 16
id = "aliso"
nombre_comun = "Aliso"
nombre_cientifico = "Alnus acuminata"
tipo = 6
estado_conservacion = 0
descripcion = "Árbol nativo de los Andes que crece cerca del agua. Sus raíces ayudan a fijar nitrógeno y mejoran el suelo, por eso se usa para restaurar la ronda de los humedales."
consejo_macro = "Busca sus amentos (las flores colgantes) y fotografíalos contra el cielo nublado."
