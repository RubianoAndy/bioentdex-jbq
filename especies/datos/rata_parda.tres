[resource]
script = ExtResource("1_esp")
numero = 19
id = "rata_parda"
nombre_comun = "Rata parda"
nombre_cientifico = "Rattus norvegicus"
tipo = 4
estado_conservacion = 0
descripcion = "Roedor introducido que se multiplica donde se acumula basura. Compite con la fauna nativa y puede transmitir enfermedades: por eso es clave no botar residuos en el humedal."
consejo_macro = "No te acerques ni la alimentes: fotografíala de lejos y documenta la basura que la atrae."
